{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>unional/renovate-preset"],
	"platformAutomerge": true,
	"rebaseWhen": "behind-base-branch",
	"minimumReleaseAge": "3 days",
	"packageRules": [
		{
			"description": "Non-major updates merge themselves through the repo's own merge settings.",
			"matchUpdateTypes": ["patch", "minor", "pin", "digest"],
			"automerge": true
		},
		{
			"description": "Majors stay manual — a human decides when to absorb the breakage.",
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"additionalBranchPrefix": "major-"
		}
	],
	"vulnerabilityAlerts": {
		"minimumReleaseAge": "1 day",
		"automerge": true
	},
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	}
}
