{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"dev": "turbo run dev --parallel",
		"format": "biome format . --write",
		"gca": "pnpm --filter=google-cloud-api",
		"iso": "pnpm --filter=iso-error",
		"iso-gca": "pnpm --filter=iso-error-google-cloud-api",
		"lint": "biome lint .",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"nuke:local": "rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "run-p lint verify:pkg",
		"verify:pkg": "turbo run build typecheck coverage depcheck openapi:validate",
		"version": "changeset version",
		"web": "pnpm --filter=iso-error-web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"turbo": "^2.10.12"
	},
	"packageManager": "pnpm@11.25.0"
}
