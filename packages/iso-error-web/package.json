{
	"name": "iso-error-web",
	"version": "2.4.3",
	"description": "iso-error web extension",
	"homepage": "https://github.com/cyberuni/iso-error/tree/main/packages/iso-error-web",
	"bugs": {
		"url": "https://github.com/cyberuni/iso-error/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/iso-error.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"default": "./esm/index.js"
			},
			"require": {
				"types": "./cjs/index.d.ts",
				"default": "./cjs/index.js"
			},
			"default": "./esm/index.js"
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"types": "./cjs/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress}.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf coverage cjs esm --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all clean -p build typecheck coverage depcheck",
		"w": "pnpm watch",
		"watch": "vitest"
	},
	"dependencies": {
		"iso-error": "workspace:^"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"depcheck": "^1.4.7",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"tsdown": "^0.22.14",
		"type-plus": "^7.6.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 8"
	}
}
